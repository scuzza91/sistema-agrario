      "item": [
        {
          "name": "GET todos (guarda productorId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productores"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if ((r.find((p) => p.cuit === \"30-12345678-9\") || r[0])._id) pm.collectionVariables.set(\"productorId\", (r.find((p) => p.cuit === \"30-12345678-9\") || r[0])._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productores/{{productorId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
