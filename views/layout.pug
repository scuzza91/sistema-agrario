doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    title= titulo
    style.
      body { font-family: Arial, sans-serif; background: #fff; color: #000; margin: 24px; }
      nav a { margin-right: 12px; }
      table { border-collapse: collapse; margin: 12px 0 24px 0; }
      th, td { border: 1px solid #000; padding: 6px 10px; text-align: left; }
      label { display: block; margin-top: 8px; }
      input, select { margin-top: 4px; }
      button { margin-top: 12px; }
  body
    h1 Sistema agrario - monitoreo de lotes
    nav
      a(href="/") Inicio
      a(href="/ver/productores") Productores
      a(href="/ver/tecnicos") Tecnicos
      a(href="/ver/tipos-cultivo") Tipos de cultivo
      a(href="/ver/lotes") Lotes
      a(href="/ver/observaciones") Observaciones
    hr
    block content
