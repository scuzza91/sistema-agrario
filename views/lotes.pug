extends layout

block content
  h2 Lotes
  table
    tr
      th Id
      th Nombre
      th Hectareas
      th Productor
      th Cultivo
      th Estado
    each item in lotes
      tr
        td= item._id
        td= item.nombre
        td= item.hectareas
        td= item.productor ? item.productor.nombre : "-"
        td= item.tipoCultivo ? item.tipoCultivo.nombre : "-"
        td= item.estado

  h3 Cargar lote
  form(method="post" action="/lotes")
    label Nombre
    input(type="text" name="nombre" required)
    label Hectareas
    input(type="number" name="hectareas" min="0.1" step="0.1" required)
    label Productor
    select(name="productor" required)
      each productor in productores
        option(value=productor._id)= productor.nombre
    label Tipo de cultivo
    select(name="tipoCultivo" required)
      each tipo in tipos
        option(value=tipo._id)= tipo.nombre
    label Estado
    select(name="estado")
      option(value="activo") activo
      option(value="en barbecho") en barbecho
      option(value="cosechado") cosechado
    div
      button(type="submit") Guardar
